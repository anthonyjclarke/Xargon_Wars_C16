; PUT "@:SETSHEET";;;*******************************;; THE INTIALISER FOR EACH SHEET;;*******************************;CLSPOS=$E0F-80SHESCR=$C00+280+36;INITSR;JSR FLLTBL;LDX SHEETN;LDA CONSHT,X   ;* CONVERSION;ASL AASL AASL AASL A;; *16 INTO SHTABL;TAX;LDA SHTABL,XSTA MVELEN   ;* MOVEMENT LENGTH;LDA SHTABL+1,XSTA MVEDALLDA SHTABL+2,XSTA MVEDAH   ;* DATA LOCATION;LDA SHTABL+3,XSTA ANISPD   ;* ANIMATION SPEED;LDA SHTABL+4,XSTA FRESPD   ;* FIRING SPEED;LDA SHTABL+5,X ;* MULTI - COL 1STA MULTI1LDA SHTABL+6,X ;* MULTI - COL 2STA MULTI2LDA SHTABL+7,X ;* ATTRIB. COL 3STA ATTCOL;LDA SHTABL+8,X ;* MOVEMENT SPEEDSTA MVESPD;LDA SHTABL+9,X  ;* CHARACTER DATA LSTA CHARDLLDA SHTABL+10,X ;* CHARACTER DATA HSTA CHARDH;LDA SHTABL+11,X ;* ALIEN DATA LSTA ALTBLLDA SHTABL+12,X ;* ALIEN DATA HSTA ALTBH;LDA SHTABL+13,X ;* NO. OF ALIENSSTA NUMALI;LDA SHTABL+14,X ;* BOMB SPEEDSTA BOMSPD;;; THE OTHER ONE BYTE  IS SPARE;;JSR LEVINC ;* LEVEL INCREASE;;;JSR GTALXY ;* SET UP ALIEN TABLE;;RTS;;*****************************;CONSHT;;.BYTE 0,12,9,3,2,13,6,8,4.BYTE 5,10,1,14,7,11,15;;;*****************************;; ALIEN TABLE X,Y,MOVEMENT NO;;*****************************;; MAX NO ( SO FAR ) = 32;; ALIENS TABLE HAS GONE TO EXTRA; MEMORY;; TABLE SIZE = 96 BYTES;;;GTALXY;;******************************;; TRANSFER ALIENS X,Y,MOVE# TO; THE MAIN PLAYING TABLE.;;******************************;;LDY #0LDA NUMALIASL ACLCADC NUMALISTA ALTEM  ;* LENGTH OF DATA;ALXYL;;LDA (ALTBL),Y;; POINTS TO INITIAL X,Y & SHOULD; HAVE BEEN SET UP BY THE ROUTINE; ABOVE - SETSCR;STA ALIENS,Y;INYCPY ALTEMBNE ALXYL;RTS;;;********************************;SHTOVR;; CLEARED SHEET;;LDX #1STX DNTFIR;DEX;STX CLALSTX PRALSTX CLBOSTX PRBO;; DON'T PRINT THE BOMBS AGAIN;TRIPE;LDA SHITSO  ;* ALIEN EXPLOSIONBNE TRIPE;WAIDTH;LDA DEADBNE WAIDTH;; WAIT INCASE HE HAS BEEN HIT; BY THE LAST ALIEN !!!!!!!;SEI;JSR CLRDIS  ;* CLS DISPLAY AREA;CLI;LDA #$FFSTA TNOTE   ;* LITTLE JINGLE;JSR INTUNE;LDA #200STA ALTEM;CLDT2;LDX #18;CLDT1;LDA ALTEMCMP #1BNE NTYED;LDA #32BNE HURTIN;NTYED;LDA CLRMES,X;HURTIN;AND #$3FSTA CLSPOS,X;;LDA TEDAND #%01110111STA CLSPOS-$400,X;DEXBPL CLDT1;LDX #$04JSR DELAY+2;;DEC ALTEMBNE CLDT2;;LDA #0STA CLRSHT ;* END OF SHEET FLAGSTA NUMHIT ;* NUMBER HIT;;SED;LDA DECSHT ;* DECIMAL COUNT+1CLCADC #1STA DECSHT;CLD;INC SHEETNLDA SHEETN;CMP #16BNE NONXLV;JSR NXLEVL    ;* NEXT LEVEL;NONXLV;LDA DECSHT;PHA;LSR ALSR ALSR ALSR A;ORA #$30;STA CLRMES+7  ;* MSBSTA SHESCR    ;* MSB;PLA;AND #%00001111;ORA #$30STA CLRMES+8  ;* LSBSTA SHESCR+1  ;* LSB;; SET UP ASCII SHEET CLEARED FOR; NEXT SHEET CLEARANCE.;;JSR INITSR ;* INIT NEW SCREEN;LDA #0STA DNTFIR;;;;;RTS;;*****************************;CLRMES;.BYTE 'XARGON 01 DESTROYED';;;;****************************;;; FILL TABLES THAT NEED TO BE; CLEARED AT THE START OF A NEW; SHEET;; IE BOMBTB;    BOMBPR;    BOMBCL;;    ALIENS;    ALIPRT;    ALICLS;FLLTBL;LDX #31LDA #$FF;FLL1;STA BOMBTB,XSTA BOMBPR,XSTA BOMBCL,X;STA ALIENS,XSTA ALIENS+32,XSTA ALIENS+64,X;STA ALIPRT,XSTA ALIPRT+32,XSTA ALICLS,XSTA ALICLS+32,X;DEXBPL FLL1;LDA #0STA MOVECTSTA BERMBSTA CLOTSTA ANICNT;RTS;;;*************************;;NXLEVL;;;LDA #0STA SHEETN;;; THE GONK HAS CLEARED ALL 16; SHEETS SO NOW LETS GIVE HIM; SOME EXTRA POINTS & MAY BE; SOME MORE LIVES ,TELL HIM; HE HAS CLEARED THIS LEVEL &; THEN GO BACK AND START THE; SHEETS ALL OVER AGAIN.;; SOME FACTORS THAT CAN BE; CHANGED ARE :-;;; FRESPD - FIRING FREQ.; MVESPD - ALIEN MOVE SPEED; BOMSPD - BOMBS MOVE SPEED;; ***************************; * NOTE THAT NONE OF THESE *; * VARIABLES MUST EVER GO  *; ***************************;LDA #$09STA TNOTE   ;* LONG TUNE;JSR INTUNE;INC LEVEL;LDY #255;LEV1;LDX #$7F;LEV2;STX BORDER;DEXBPL LEV2;DEYBNE LEV1;LDA #2         ;* BONUS SCORETAY            ;* OF;              ;* 200JSR ADDSCR+2   ;* POINTS;JSR ADDLIF     ;* 1 EXTRA LIFE;TUWAT;LDA PLAYTUBNE TUWAT;; WAIT FOR TUNE TO FINISH;RTS;;;;*********************;;; LEVEL INCREASE;;LEVINC;LDA LEVELCMP FRESPD;BCC TROG1;LDA #1STA FRESPD;BNE NOINC1;TROG1;LDA FRESPDSECSBC LEVELSTA FRESPD;NOINC1;LDA LEVELCMP MVESPD;BCC TROG2;LDA #1STA MVESPD;BNE NOINC2;TROG2;LDA MVESPDSECSBC LEVELSTA MVESPD;NOINC2;LDA LEVELCMP BOMSPD;BCC TROG3;LDA #1STA BOMSPD;BNE NOINC3;TROG3;LDA BOMSPDSECSBC LEVELSTA BOMSPD;NOINC3;RTS;; THE WHOLE ROUTINE SUBTRACTS; THE LEVEL FROM THE VALUE; AND ENSURES THAT NO NUMBER; LESS THAN 1 WILL EVER BE; PRODUCED;;;;;;.END