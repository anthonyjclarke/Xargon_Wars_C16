; PUT "@:SMOOTH-SCROLL";;*****************************;; SMOOTH MESSAGE SCROLL STUFF;;*****************************;CHARS=$3E80  ;* CHAR 128 STARTCHARX=$3F10  ;* LAST CHAR;;;;SCROLL;; SCROLL HI-CODE;;LDA LOSCRLCMP #8BNE MONKEY;; NEED TO PUT NEW CHAR IN;LDA #0STA LOSCRL;;PARIS;LDX HISCRLLDA SROLBF,X  ;* SCROLL BUFFERCMP #$FFBNE REJECT;LDX #0STX HISCRLSTX LOSCRL;BEQ PARIS;REJECT;INC HISCRL;CMP #$20BNE KRTH;LDY #7LDA #0;KLM;STA CHARX,Y;DEYBPL KLM;JMP MONKEY;KRTH;; GOT NEXT CHAR;ASL AASL AASL A;TAX;LDY #0;BISTO;LDA $3C00,X  ;* CHARACTER SETSTA CHARX,Y;INXINYCPY #8;BNE BISTO;; NEXT CHAR IN AT CHARX;;;MONKEY;INC LOSCRL  ;* LO COUNT;LDX #0;CREAM;;;;;;ASL CHARS+144,X;;ROL CHARS+136,XROL CHARS+128,XROL CHARS+120,XROL CHARS+112,XROL CHARS+104,XROL CHARS+96,XROL CHARS+88,XROL CHARS+80,XROL CHARS+72,XROL CHARS+64,XROL CHARS+56,XROL CHARS+48,XROL CHARS+40,XROL CHARS+32,XROL CHARS+24,XROL CHARS+16,XROL CHARS+8,XROL CHARS,X;INXCPX #8;BNE CREAM;RTS;;;;*************************;;SMOOTH;; SET UP ABOVE;LDX #0;SM1;LDA CHARS,XSTA SAVECH,X;LDA #0STA CHARS,X;INXCPX #$A0BNE SM1;LDA #0STA LOSCRLSTA HISCRL;LDX #80  ;* START CHARLDY #0;SM2;TXASTA $F85,Y;LDA #$66STA $B85,Y;INXINYCPY #18BNE SM2;; ON THE SCREEN NOW;RTS;;;;.END