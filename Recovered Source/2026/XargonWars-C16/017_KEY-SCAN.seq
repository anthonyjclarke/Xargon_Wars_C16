; PUT "@:KEY-SCAN";; THIS WILL BE CALLED FROM THE; JOYSTICK READ ROUTINE IF IT; FINDS THERE IS NO JOYSTICK; MOVEMENT,; IT WILL THEN CLEAR OR SET THE; APPROPRIATE VARIABLES IF KEYS; ARE PRESSED;; NOTE IT WILL SET OR CLEAR; JMOVE AS APPROPRIATE;;;KEY;LDA #0STA JMOVE;LDX #4;SCAN1;LDA BTD,XLDY RWD,X;JSR KEYIT;ROR JLEFT,X;DEXBPL SCAN1;RTS;; LEFT  = 'ESC'; RIGHT = '1'; UP    = 'F3'; DOWN  = 'HELP'; FIRE  = 'F1';KEYIT;STY $FD30STY $FF08AND $FF08;BNE RTTY;LDA #$01STA JMOVESEC;RTS;RTTY;CLC;RTS;;BTD;;      L   R   U   D   F;.BYTE $10,$01,$40,$08,$10;RWD;.BYTE $BF,$7F,$FE,$FE,$FE;.END