; PUT "@:ANIMATE";;********************;; ANIMATION ROUTINES;;********************;ALCHAR=$3F28EXCHAR=$3F48ALBULC=$3F40LAXCHR=$3EE0;;;ANICHR;;******************************;; ANIMATE THE ALIEN CHARACTERS;;******************************;INC ANICNT ;* ANICOUNTLDA ANICNTCMP ANISPD ;* ANIMATION SPEED;BNE SODOFF ;* !!!!;LDA #0STA ANICNT;LDX FRAMEINXCPX #4BNE FOK;LDX #0;FOK;STX FRAME;LDY TIME24,X;LDX #0;CHRLP;LDA (CHARDL),YSTA ALCHAR,X   ;* ALIEN ANIMATION;LDA EXPLAN,YSTA EXCHAR,X   ;* EXPLOSION ANI.;INYINXCPX #24BNE CHRLP;;LDA FRAMEAND #1ASL AASL AASL ATAXLDY #0ANLP;LDA FICHAR,XSTA ALBULC,Y;LDA LACHAR,XSTA LAXCHR,Y;INXINYCPY #8BNE ANLP;SODOFF;RTS;;;;;********************************;TIME24 ;* TIMES 24 DATA TABLE !!;.BYTE 0,24,48,24;;********************************;;;.END ANIMATE