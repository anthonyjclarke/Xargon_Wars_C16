; PUT "@:GAUGE";;;*****************************;; ALL THE HEAT GAUGE ROUTINES;;*****************************;;PRGAGE;;;LDA #$44STA GLLDA #$0FSTA GH;LDA HEAT;CMP #8BCC PHIL ;* NO FULL CHARS;AND #%11111000LSR ALSR ALSR A;; NO. OF FULL CHARS;TAX;;;LDY #0;GLP;LDA #100;STA (GL),Y;LDA GLSECSBC #40STA GL;LDA GHSBC #0STA GH;DEXBNE GLP;PHIL;LDA HEATAND #7;BNE NORMAL;LDA #32BNE NOTNOR;;NORMAL;CLCADC #92;NOTNOR;; TOP CHAR (VARIABLE);LDY #0STA (GL),Y;;LDA GLSECSBC #40STA GL;;LDA GHSBC #0STA GH;LDA GLCMP #$64BEQ TOPBIT;LDA #32STA (GL),Y ;* CLEAR TOP BIT;TOPBIT;LDA GCOL ;* GAUGE COLOUR;LDA NFIREBNE SHIT;LDA #$71BNE POOH;SHIT;INC NFIRELDA NFIREAND #%00001111ORA #%01010000STA NFIRE;POOH;LDX #6;GA1;LDY YCOL,XSTA $09B4-40,YSTA $0A54,YDEXBPL GA1;RTS;;;*************;CLSGAG;LDX #6;GAZ1;LDA #32LDY YCOL,X;STA $0DB4-40,YSTA $0E54,Y;DEXBPL GAZ1;RTS;;;;;.END