; PUT "@:HIGH-STUFF";;*****************************;; DO ALL THE HIGH SCORE STUFF;;*****************************;;;SCRBUF .BYTE '00000';; SCRBUF MUST BE FILLED WITH; THE SCORE FROM THE LAST GAME; BEFORE HIGH ROUTINE IS CALLED;HIGH;LDA #0STA HISPNT;STA POSITN;;HLP1;LDA HISPNTCLCADC #5;TAX;SECLDY #5;HLP2;LDA HISTBL-1,XSBC SCRBUF-1,Y;DEXDEYBNE HLP2;BCC ITSIN ;* GOT IN !!!;LDA HISPNTCLCADC #14STA HISPNT;INC POSITN;LDA POSITNCMP #7BNE HLP1;; NOT IN THE TABLE - SUSSED;RTS;;********************************;ITSIN;LDA PLAYIN   ;* IS GAME IN PROG.BEQ NOINGM   ;* AT END;RTS;; WILL RETURN HERE IF THE ROUTINE; IS BEING USED IN THE GAME TO GET; THE RANK.;NOINGM;; IN AT POSITN  (0-5);JSR MVESCR   ;* MOVE SCORES DOWNJSR PRHISC   ;* PRINT TABLE;JSR CLBOXJSR BOXES;RTS;;;********************************;HOFSET .BYTE 0,14,28,42,56,70;SCROFT;.WORD $0DEC.WORD $0DEC+80.WORD $0DEC+80+80.WORD $0DEC+80+80+80.WORD $0DEC+80+80+80+80.WORD $0DEC+80+80+80+80+80;;MVESCR;LDX POSITN;LDA HOFSET,X;STA INCNT;CPX #5BEQ INLAST;LDX #70;MOVESC;LDA HISTBL,XSTA HISTBL+14,X;DEXCPX INCNT;BNE MOVESC;INLAST;LDX INCNT;LDY #0;MVT1;LDA SCRBUF,YSTA HISTBL,X;INXINY;CPY #5BNE MVT1;; SCORE IN;JSR PRHISC   ;* PRINT UPDATED TBL;LDA POSITNASL ATAX;LDA SCROFT,X;STA SLSTA COLL;LDA SCROFT+1,X;STA SH;SECSBC #4;STA COLH;;; SL,SH POINT TO SCREEN; WHERE TO ENTER NAME;;LDY #5;LUMP;LDA #1STA STRIN,Y;DEYBPL LUMP;LDA INCNT;CLCADC #7;STA XBLOB   ;* OFFSET INTO TABLE;LDA #0STA LETTER  ;* NO OF LETTERS;JMP PRITIT;NOLOP;JSR REDJOS;LDA LETTERTAY;;BIT JFIRE   ;* FIRE = FINISHEDBPL NO;RTS         ;* FINISHED;NO;BIT JUP     ;* CHAR=CHAR+1BPL CHUP;LDX STRIN,Y;INXCPX #58BNE NOT9    ;* NOT Z YET;LDX #1BNE NOTZ;NOT9;CPX #30BNE NOTZ;LDX #48     ;* NOW TO ZERO;NOTZ;TXASTA STRIN,Y;;;****************************;CHUP;BIT JDOWN      ;* CHAR=CHAR-1BPL CHDOWN;LDX STRIN,Y;DEX;BNE NOTR;LDX #57BNE NOTA;NOTR;CPX #47BNE NOTA;LDX #29;NOTA;TXASTA STRIN,Y;;;****************************;CHDOWN;BIT JLEFT      ;* EDIT CHAR -1BPL CHLEFT;DEY;BPL NA3;LDY #0;NA3;STY LETTER;;;*********************;CHLEFT;BIT JRIGHTBPL PRITIT;INY;CPY #6BNE NA4;LDY #5;NA4;STY LETTER;;*********************;PRITIT;LDY #5;NA5;LDA STRIN,YSTA (SL),Y    ;* ONTO SCREEN;DEYBPL NA5;JSR FLALET    ;* FLASH LETTER;LDX XBLOB;LDY #0;NA6;LDA STRIN,YSTA HISTBL,X;INXINY;CPY #6;BNE NA6;;LDX #$30STX DELAY+1;JSR DELAY;JMP NOLOP;FLALET;LDY #5;FLP1;CPY LETTERBNE NOFLP1;LDA #$71BNE NOFLP2;NOFLP1;LDA #$11;NOFLP2;STA (COLL),Y;DEYBPL FLP1;RTS;;;**********************;STRIN .BYTE '012345';; TEMP FOR NAME INPUT;;;**********************;;; ALL THE HISCORE CRAP;;**********************;HISTBL;;.BYTE '01000',0,0,'M.P.L.',0.BYTE '00750',0,0,'BEAVER',0.BYTE '00500',0,0,'MONTY ',0.BYTE '00250',0,0,'SAM   ',0.BYTE '00100',0,0,'POTTY ',0.BYTE '00050',0,0,'GRUMPY',0.BYTE 'THIS IS A DUMMY';BANNER;.BYTE 'XARGON  HEROES',0;;PRHISC;; PRINT HI-SCORE TABLE;LDX #0;BANL;LDA BANNER,XBEQ BANSAND #$3FSTA $D6B,XINXBNE BANL;;BANS;LDA #$E2STA SLSTA CLLDA #$0DSTA SHLDA #$09STA CH;;LDA #1STA NUMB    ;* NUMBER;LDX #0;HOOLOP      ;* MAIN LOOP;LDY #0STY MENATW;LDA NUMBORA #$70STA (CL),Y;PHA;LDA NUMBORA #$30    ;* DIGIT;STA (SL),YINY  ;PLASTA (CL),YSTA ALTEM;LDA #$2ESTA (SL),YINY;LDA #4STA TEMCNT;HOOW;LDA HISTBL,X;STA WALL;CMP #'0BNE FOO2;CPY #6BEQ FOO3;LDA MENATWBNE FOO3;LDA #32BNE FOO1;FOO2;LDA #1;STA MENATW;FOO3;LDA WALL;FOO1;STA (SL),Y;INY;INX;DEC TEMCNT;BPL HOOW;INY;; SPACE;;;LDA #$2DSTA (SL),YINY;;; SPACE;INY;INXINX            ;* MOVE ON TWO;LDA #5STA TEMCNT;HOOQ;LDA HISTBL,XAND #$3FSTA (SL),Y;LDA ALTEMSTA (CL),Y;INY;INX;DEC TEMCNTBPL HOOQ;LDA SLCLCADC #80STA SLSTA CL;LDA SHADC #0STA SH;SECSBC #4STA CH;;;INX      ;* DUMMY;INC NUMB;LDA NUMBCMP #7BEQ HRR;JMP HOOLOP;HRR;RTS;.END HIGH-STUFF