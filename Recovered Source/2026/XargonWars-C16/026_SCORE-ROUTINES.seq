; PUT "@:SCORE-ROUTINES";;SCRPOS=$C00+80+34;SCORE;; CALLED UNDER INTERRUPT; WHEN AN ALIEN HAS BEEN HIT;JSR XTRALI   ;* XTRA LIFE ?;LDX SHEETN   ;* 0-15INX;;      SCORING PROCEEDURE;      ******************;; FIRST 9 SHEETS HIT VALUE=SHEETN;; AFTER THAT 10 FOR EVERY ALIEN;LDA LEVELBNE HOWE;; IF NOT LEVEL 0 THEN ALWAYS; ADD 10;TXACMP #9BCS HOWE;JSR ADDSCR   ;* ADD SCORE;RTS;;****************************;HOWE;; ADD 10;LDA #1LDY #3JSR ADDSCR+2;RTS;;****************************;;ADDSCR;LDY #4       ;* LSB DIGIT;; SECOND ENTRY POINT;STA SCRADD;ADDLOP;LDA SCRADD;MADONA;CLCADC SCRPOS,YCMP #$3ABMI SCOREL;SECSBC #$ASTA SCRPOS,Y;LDA #1DEYBPL MADONA;SCOREL;STA SCRPOS,Y;RTS;;;*********************;XTRALI;; ADD XTRA LIFE EVERY THOUSAND;LDA SCRPOS+1  ;* THOUSANDSAND #15;CMP XTROB;BNE GRUMP;RTS;GRUMP;STA XTROB;ADDLIF;; SECOND ENTRY POINT TO ADD LIFE; IF POSSIBLE;LDA GLIVESCMP #9;BEQ TRMY;INC $0C00+236INC GLIVES;TRMY;RTS;;.END