; PUT "@:TUNE";;; AN INTERRUPT TUNE PLAYING; SUBROUTINE.REMEMBER TO CALL; THE 'INTUNE' TO SET UP ALL; THE TUNE STUFF & THE IRQ MUST; CALL 'TUNEUP'.;;INTUNE;LDA CFLAG ;* SOUND ON ?BNE TU1   ;* YES;RTS       ;* NO;TU1;;STA NOTLEN ;* NOTE LENGTH;;LDA #0STA SOU2LOSTA SOU2HI;LDA #1STA PLAYTU ;* NOW PLAYING;RTS;;;;*****************************;; THIS BIT CALLED BY THE IRQ;TUNEUP;LDA CFLAGBEQ TUT4;LDA PLAYTU  ;* TUNE ON ?BNE TUT3;TUT4;RTS;TUT3;DEC NOTLENBEQ TUT5;LDA NOTLENCMP #1BNE TUT4;LDA VOLORA #%10000000STA VOL;BMI TUT4;; TIME FOR A NEW NOTE;TUT5;INC TNOTE     ;* NOTE POINTERLDA TNOTE;;ASL ACLCADC TNOTETAX;; *3;LDA TUNDAT,X   ;* NOTE LOSTA SOU2LO;LDA TUNDAT+1,X ;* NOTE HISTA SOU2HI;LDA TUNDAT+2,X ;* LENGTHSTA NOTLEN;CMP #$FFBEQ TUTI5;LDA VOLAND #%01111111ORA #%00100101STA VOL;RTS;;***********************;TUTI5;LDA #0STA PLAYTUSTA SOU2LOSTA SOU2HILDA VOLAND #%01011111STA VOL;RTS;; END OF TUNE;;;.END