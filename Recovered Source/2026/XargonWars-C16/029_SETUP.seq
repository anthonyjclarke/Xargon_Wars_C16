; PUT "@:SETUP";;*****************************;; INITIALISE ALL POINTERS ETC.;;*****************************;SETUP;LDA #$08JSR OUCHAR     ;* DISABLE SHFT/COMM;LDA #$93JSR OUCHAR     ;* CLS SCREEN;;LDA TED+7;ORA #%1001000  ;* DISABLE REVERSE;STA TED+7;LDA #$00STA BACKGR     ;* BLACK SCREENSTA BORDER     ;* BLACK BORDER;;LDA #$00;STA TED+17     ;* CLEAR SOUND;LDA TED+18AND #%11111011 ;* CHARS FROM RAMSTA TED+18;LDA #$3CSTA TED+19     ;* CHARS AT $3800;LDA #%00010000ORA TED+7      ;* MULTI COLOURSTA TED+7;LDX #3RNLLDA RASCOM  ;* TIMERS AS RND #STA RND,XDEXBPL RNL;;*SEED;RTS;;;.END SETUP