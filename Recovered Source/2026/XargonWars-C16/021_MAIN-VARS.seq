; PUT "@:MAIN-VARS";;;  MAIN VARIABLES THAT AFFECT; THE APPEARANCE OR PERFORMANCE; OF THE GAME.;;SHIPST = $0F57;; SHIP SCREEN START POSITION;;NTRIES = 24;; ALIEN BOMB FREQUENCY (NUMBER; OF ATTEMPTS AT STARTING A NEW; BOMB.);;BSPEED = 3;; SPEED OF YOUR BULLET;BCOLOR = $76;; BULLET COLOUR;;TUNDAT=$1C00;; TUNE DATA FOR BOTH TUNES;;STCHAR = 117;; STAR FIRST CHAR;STCOL;.BYTE $7B,$7D,$7E,$7F;; COLOUR FOR THE 4 SPEED STARS;SPPIX;.BYTE 4,2,2,1;; PIXEL SPEED FOR 4 SPEED STARS;STOP;.BYTE 1,1,1,1;; STOP FLAG FOR STARS;MAXNOS = 16;; MAX NUMBER OF STARS;;SHTABL = $1010;;MAXLIV = 4;; MAX NUMBER OF LIVES;;;;.END