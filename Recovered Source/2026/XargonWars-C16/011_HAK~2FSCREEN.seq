; PUT "@:HAK/SCREEN";; CHOOSE ANY SCREEN YOU LIKE;; PRESS 0 - F;;HAKER;;LDX #0;SKAN1;LDA BITTY,XLDY ROWDY,X;JSR KEYIG;BCC FRNXT;STX HACK;; SCREEN SELECTED;FRNXT;INXCPX #16BNE SKAN1;LDA HACKCMP #10BCC DFUF;ADC #$36AND #$3FSTA $FD4BNE GFUF;DFUF;ORA #$30STA $FD4;GFUF;RTS;;;;;;;KEYIG;STY $FD30STY $FF08AND $FF08;BNE RGTY;SEC;RTS;RGTY;CLC;RTS;;BITTY;;.BYTE $08.BYTE $01,$08,$01,$08.BYTE $01,$08,$01,$08.BYTE $01,$04,$10,$10.BYTE $04,$40,$20;ROWDY;.BYTE $EF.BYTE $7F,$7F,$FD,$FD.BYTE $FB,$FB,$F7,$F7.BYTE $EF,$FD,$F7,$FB.BYTE $FB,$FD,$FB;.END