; PUT "@:KILLER";;;******************************;;    THE KILLING ROUTINES !!;; AND I AM DREADING DOING THEM;;******************************;;;ALIHIT;LDA HITFLG ;* ALIEN HIT ????BNE SICH;RTS;SICH ;* YES !;LDA UNDER ;* CHAR UNDER BULLET;AND #3TAXDEXSTX GORGE;LDA HITXSECSBC GORGESTA HITX;CPY #40BNE CAMEL1;INC HITY;CAMEL1;; NOW THE 'HITX' VARIABLE HOLDS; THE CORRECT X,Y CO-ORD OF THE; ALIEN THAT WILL CORRESPOND; TO AN ALIEN IN THE 'ALIENS'; TABLE - I HOPE !!!!!!!!!;LDA #0STA ALTEM;MEAT;LDA ALTEMASL ACLCADC ALTEMTAX;LDA ALIENS,X   ;* X POSAND #$1FCMP HITX;BNE HAMMER     ;* NO TRY NEXT ONE;LDA ALIENS+1,X ;* Y POSCMP HITY;BNE HAMMER     ;* Y'S NOT THE SAME;;;*******************************;;    *   *  ***  *   *   * *;    *   * *   * *   *   * *;    * * * *   * * * *   * *;    ** ** *   * ** **;    *   *  ***  *   *   * *;;*******************************;;;; I THINK WE'VE FOUND THE ALIEN; THAT HAS BEEN HIT;;;LDA ALIENS+1,X    ;* Y POSORA #$80STA ALIENS+1,X;LDA ALIENS,XAND #%00011111    ;* SET EX COUNTSTA ALIENS,X;INC NUMHIT        ;* NUMBER HIT;; SET THE TOP BITS INDICATING IT; IS NOW AS DEAD AS A DOORMOUSE!;;LDA #0STA FIRESTA BONSTA BOFFSTA HITFLG;; START TIMER GOING;;JSR HITSND ;* START SOUND EFFECT;JSR SCORE;JMP HELPME ;* GET OUT;HAMMER ;* TO FALL !!;INC ALTEMLDA ALTEM;CMP NUMALI ;* LAST ONE ?;BNE MEAT;HELPME;LDA #32;LDY #0STA (BULLET),Y;LDY #40STA (BULLET),Y;;LDA NUMHITCMP NUMALI;BNE BEAT;LDA #1STA CLRSHT  ;* CLEARED SHEET;BEAT;RTS;;;;*******************************;;;;;UPEXPL;;;LDA #0;STA NOBBO;MUDDY;LDA NOBBOASL ACLCADC NOBBOTAX;LDA ALIENS+1,X ;*TOP BIT SET = DEADBPL GUMBY      ;* !!!;LDA ALIENS,X    ;* X POS TOP 3 BITSAND #%01100000 ;* EXPLOSION COUNT;LSR ALSR ALSR ALSR ALSR A          ;* SHOVE DOWN COUNT;CLCADC #1         ;* NEXT FRAME;AND #3         ;* MAKE SURE 3 BITS;; IF THE ACC HOLDS ZERO THEN END;BNE ABACAB     ;* NOT FINSHED;LDA #$FFSTA ALIENS,XSTA ALIENS+1,XSTA ALIENS+2,X ;* IT IS NO LONGER!BNE GUMBY      ;* GET OOOOTTT !;ABACAB;ASL AASL AASL AASL AASL A          ;* BITS UP AGAIN;PHA;LDA ALIENS,XAND #%10011111 ;* SOD OFF BITS;PLAORA ALIENS,XSTA ALIENS,X;;GUMBY;INC NOBBOLDA NOBBOCMP NUMALIBNE MUDDY;;;RTS;.END KILLER