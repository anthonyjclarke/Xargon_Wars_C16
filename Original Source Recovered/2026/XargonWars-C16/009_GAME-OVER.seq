; PUT "@:GAME-OVER";;;;KATH;LDA #0STA DEMOSTA PLAYIN ;* NOT IN GAME;WAIP;LDA TEDAND #7BEQ WAIPORA #$30;STA CURCOLSTA BORDER;JSR NORIRQ;JSR COLCLS;JSR GAMCLS;LDA #200STA ALTEM;KT2;LDX #$04JSR DELAY+2;INC BORDER;JSR POTBEL;DEC ALTEMBNE KT2;;;;JMP BLOGGS;;;;;DELAY;LDX #$00;LDY #$00;DLPO;;NOPNOPNOP;;DEYBNE DLPO;DEXBNE DLPO;RTS;;**********;CLRDIS;LDA #30STA XSLDA #22STA YSLDA #32STA CHARLDX #1LDY #1;JSR BOX ;* CLEAR GAME PLAY AREA;RTS;;;;*****************************;;GAMCLS;; CLEAR SCREEN AT GAME OVER;;LDA #32STA XS;LDA #24STA YS;;;LDY #0;;;GAML1;STY HITYLDA #0STA HITX;JSR PRBOX;;TYAPHA;;JSR CURTAN;LDX #$40JSR DELAY+2;PLATAY;DEC YSDEC YS;INY;CPY #11BNE GAML1;INC HITY;JSR CURTAN;JSR POTBEL;LDY #11;GAML2;STY HITYLDA #0STA HITX;JSR PRBOX;TYAPHA;LDX #$40JSR DELAY+2;PLATAY;JSR RUBBOX;INC YSINC YS;DEYBPL GAML2;DEC YSDEC YS;INY;JSR PRBOX;RTS;;;***********;POTBEL;LDX #31;PTY;LDA GAMMES,XAND #$3FSTA $0DE0,X;LDA $0DE0-$400,X;ADC #1AND #$77;STA $0DE0-$400,X;DEXBNE PTY;RTS;;;GAMMES;.BYTE '            GAME OVER           ';;;;;COLCLS;LDA #30STA XSLDA #22STA YSLDA #$FFSTA CHARLDX #1LDY #1LDA #$71JSR BOX ;* CLEAR GAME PLAY AREA;RTS;;**********************;CURTAN;CPY #0BNE JUNKIE;RTS;JUNKIE;DEY;LDX #0;JSR XY;JSR CLOTH;LDA YSCLCADC HITYADC #1TAY;LDX #0;JSR XY;CLOTH;JSR SYNC;LDY #32;JUNK1;LDA #79STA (SL),Y;LDA CURCOLSTA (CL),Y;DEYBPL JUNK1;;RTS;;.END