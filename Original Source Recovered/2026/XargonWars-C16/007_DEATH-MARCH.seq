; PUT "@:DEATH-MARCH";;; DEATH OF SHIP STUFF;;;;UPDEAD;LDA DEADBNE UPSOK;IPSOK;RTS;UPSOK;LDA FINITOBNE IPSOK;;; JUST PRINT GAME OVER;LDA DEATHBNE DOINGT;; WE ARE HERE FOR THE FIRST; TIME TO START OFF THE FADING; AWAY;LDA #1STA DEATH;LDA #66STA DCOUNT;LDA #1STA TDEAD;LDX #55;ANTS;LDA $3E80,XSTA SAVECH,X;DEXBPL ANTS;;JSR SETEXP ;* SET EXPLOSION SND;;RTS;DOINGT;INC SHIPCLLDA SHIPCL;AND #$7FSTA SHIPCL;DEC TDEADBEQ DODT;RTS;DODT;LDA #5STA TDEAD;DEC DCOUNTBNE DODOT;JMP DEADRI ;*NGER FOR LOVE;DODOT;JSR DYEVOL;LDA DCOUNTCMP #20BCS DTFLSH;LDX #55;ANTS2;LDA $3E80,XAND TEDSTA $3E80,X;DEXBPL ANTS2;NODESN;RTS;DTFLSH;LDX #55;DTL1;LDA $3E80,XEOR TEDAND SAVECH,XSTA $3E80,X;DEXBPL DTL1;RTS;;DEADRI;; FINISHED ALL THE DYING STUFF;LDA #0STA VOLSTA SOU1LOSTA SOU1HISTA SOU2LOSTA SOU2HISTA DEADSTA DEATHSTA HEAT;; ALL SOUND OFF;JSR CLSGAG    ;* CLEAR GAUGE;LDX #55;ANTS3;LDA SAVECH,XSTA $3E80,X;DEXBPL ANTS3;LDA SHEETNAND #3ADC #1ORA #$70STA SHIPCL;; COMES HERE WHEN SHIP HAS BEEN; HIT;DEC $0C00+200+36DEC GLIVES ;* GAME LIVES;; 0 MEANS ON LAST LIFE;BNE CARRY  ;* MORE TO GO YET !;LDX #4;GETSCR;LDA DEMOBEQ NORMD;LDA #'0BNE NORT;NORMD;LDA $0C00+80+34,XAND #$3F;NORT;STA SCRBUF,X;DEXBPL GETSCR;; THATS THE WALLIES SCORE FOR; HIGH STUFF;;; NOW TELL THE NORMAL LOOP; THAT ITS ALL OVER;;LDA #1STA FINITO;RTS;CARRY;; MORE LIVES YET;;;;;;LDA #0STA FINITO;;; GO BACK AND CARRY ON;;RTS;;;;;;.END