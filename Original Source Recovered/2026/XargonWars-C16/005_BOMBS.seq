; PUT "@:BOMBS";;******************************;; ALL THE ALIENS BOMBING STUFF;;******************************;;;;;NEWBMB;LDX #0;HUNTPS;LDA BOMBTB,XCMP #$FFBNE NOTTR;LDA BOMBTB+1,XCMP #$FFBEQ WEHVIT;;NOTTR;INXINX;CPX #32;BNE HUNTPS;RTS;; NO ROOM FOR ANY BOMBS;;;*******************************;WEHVIT;STX BOMCNT ;* POINTER FOR NEW ONE;; SET UP A NEW BOMB;LDA #NTRIESSTA TRIES;TIRANO;JSR RANDOM;LDA RND+1AND #$1F   ;* STRIP OFF TO BITSCMP NUMALIBCS TIRANO;STA BMTMPASL ACLCADC BMTMP;TAX          ;* POINTS TO AN ALIEN;LDA ALIENS+1,X ;* CHECK IF IT'S OKBPL GRUNT      ;* IT'S A O.K. !!;; IF IT GETS HERE IT MEANS THE; ALIEN WAS EITHER DEAD OR IN; AN EXPLOSION.;DEC TRIES;BNE TIRANO;RTS;GRUNT ;* WE'VE GOT AN ALIEN;LDY BOMCNT;LDA ALIENS,X      ;* XPOSAND #%00011111CLCADC #1STA BOMBTB,Y      ;* = XPOS + 1;LDA ALIENS+1,XAND #$1FSTA BOMBTB+1,Y    ;* = YPOS + 1;; IT'S GOT AN X & Y POS NOW;;;;RTS;;;*******************************;;MVEBMB ;* MOVE THE BOMBS DOWN;LDA #0STA PRBOSTA CLBO;LDX #31;DISK;LDA BOMBPR,XSTA BOMBCL,X;LDA #$FFSTA BOMBPR,X;DEXBPL DISK;; COPY PRINT TABLE TO CLS TABLE;LDX #0;;TONY;LDA BOMBTB,X    ;* X POSSTA BOMEXLDA BOMBTB+1,X  ;* Y POSSTA BOMEY;CMP #$FF        ;* NOT THERE !BEQ DRUNK;TAY;INYCPY #24 ;* BOTTOM OF SCREEN;BNE QUEEN;; LETS KILL THIS BULLET;LDA #$FF;STA BOMBTB,X      ;* BYE X,Y TBLSTA BOMBTB+1,X;JMP DRUNK;QUEEN;TXAPHA;STY BOMEYLDX BOMEX;JSR RUSTIC ;* X,Y TO SCREEN;PLATAX;LDA SCLOSTA BOMBPR,XLDA SCHISTA BOMBPR+1,X;; PUT ADDRESS IN BOMB PRINT TABLE;LDA BOMEYSTA BOMBTB+1,X;; PUT NEW Y POS INTO TABLE;;;DRUNK;;INXINX;CPX #32;BNE TONY;LDA #1STA PRBOSTA CLBO ;* GO FOR IT !;RTS;;*****************************;CLBOMB;LDA CLBOBEQ VENUS ;* ? WHAT;LDX #0;BOSTON;LDA BOMBCL,XSTA ILLDA BOMBCL+1,XSTA IHCMP #$FFBEQ BOZO;LDY #0LDA #32STA (IL),Y;BOZO;INXINX;CPX #32;BNE BOSTON;LDA #0STA CLBO;VENUS;RTS;;;PRBOMB;;LDA PRBOBEQ VENUS ;* CRAFTY EH !;LDX #0;CROSS;;LDA BOMBPR,XSTA ILSTA CLLDA BOMBPR+1,XSTA IHCMP #$FFBEQ NIGHT;SECSBC #4 ;* COLOUR;STA CH;LDY #0;LDA (IL),Y;CMP #101BCC PRBIT;CMP #108BCS PRBIT;JMP NIGHT;; IF NOT ALIEN THEN PRINT IT;PRBIT;CMP #80     ;* BASE BOTTOM CHARBCC PRVOT;CMP #91     ;* BASE TOP CHARBCS PRVOT;LDA #1STA DEAD;PRVOT;LDA #104;STA (IL),Y;UPYRT;LDA TEDAND #$07BEQ UPYRT;ORA #$70;STA (CL),Y;NIGHT;INXINX;CPX #32BNE CROSS;;RTS;;;.END BOMBS