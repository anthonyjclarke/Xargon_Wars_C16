; PUT "@:IRQ";;*********************;; ALL THE IRQ ROUTINES;;*********************;IRQMSK=TED+10RASCOM=TED+11IRQREG=TED+9LO2TMR=TED+2HI2TMR=TED+3;;;TIM2=$3800;RASVAL=210 ;* BOTTOM OF SCREENVARIAB=16  ;* HEAT RATE DECREMENTOVERHT=$57 ;* OVER HEAT VALUECOOLHT=$31 ;* COOL HEAT VALUE;SETIRQ;SEI;LDA #<SERVSTA $0314LDA #>SERVSTA $0315;LDA #%00010010STA IRQMSK;; ENABLE IRQ'S FROM :-;; RASTER; TIMER 2;;LDA #RASVALSTA RASCOM;;SET RASTER COMPARE;LDA #<TIM2LDX #>TIM2STA LO2TMRSTX HI2TMR;;CLI;RTS;;;;SERV;;************************;;IRQ COMES HERE - WOW !!!;;************************;;LDA IRQREGSTA ITYPESTA IRQREG ;* RESET BITS;AND #%00010000;; WAS IT TIMER 2 ?;BNE TIMER2;;;;*************************;; RASTER SERVICE ROUTINE;;*************************;;JSR PRSTAR ;* PRINT STARSJSR CLALIN ;* CLEAR ALIENSJSR CLBOMB ;* CLEAR BOMBSJSR SOUND  ;* UPDATE SOUNDSJSR PRALIN ;* PRINT ALIENS   JSR PRBOMB ;* PRINT BOMBSJSR PRBLET ;* PRINT BULLETJSR PRGAGE ;* PRINT GAUGEJSR PRSHIP ;* PRINT SHIP;NOPNOPNOP;JSR UPDEAD ;* DO DEAD STUFF;JMP IRQEND;;       ****** NOTE ******;; IN THE RASTER IRQ IT IS POSSIBLE; THAT IN THE COMPLETE VERSION; THAT THE JSR MVSTAR IS CALLED; AND IS REMOVED FROM THE TIMER;;*************************;; TIMER 2 SERVICE ROUTINE;;*************************;TIMER2;JSR MVSTAR ;* MOVE STARSJSR GATUFF ;* GAUGE STUFFJSR ANICHR ;* ANIMATE ALIENS !JSR REDJOS ;* READ JOYSTICKJSR MVEBUL ;* MOVE BULLET UPJSR MVSHIP ;* MOVE SHIPJSR HEMOGL ;* COLOURS ON SIDE !!;JSR TUNEUP ;* UPDATE TUNE IF NECC.;;LDA #<TIM2LDX #>TIM2STA LO2TMRSTX HI2TMR;;SET TIMER2 COUNT;;JMP IRQEND;;;;************;;  IRQ EXIT;;************;IRQEND;PLATAYPLATAXPLARTI;;;;;GATUFF;;*************;; GAUGE STUFF;;*************;INC HCOUNTLDA HCOUNTCMP #VARIABBNE NOTYET;LDA #0STA HCOUNT;DEC HEATLDA HEAT;BPL NOTYET;LDA #0STA HEAT;; LASER TEMP -1;NOTYET;LDA NFIREBEQ NOTOVE;LDA HEAT;CMP #COOLHTBCS NOTYAR;LDA #0STA NFIRE;;;NOTYAR;;RTS;NOTOVE;LDA HEATCMP #OVERHT;BCC NOTYAR;LDA #1STA NFIRE;JSR HEATSO ;* OVER HEAT SOUND;RTS;;;;.END IRQ