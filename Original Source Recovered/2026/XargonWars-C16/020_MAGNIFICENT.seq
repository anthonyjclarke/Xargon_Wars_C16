; PUT "@:MAGNIFICENT";;*****************************;; DO ALL THE NICE TITLE STUFF;;*****************************;;;;;BLOGGS;LDX #$FETXS;;LDA #0STA VOL    ;* NO SOUND AT ALL;;JSR CLPAG3 ;* CLEAR PAGE 3;;;; SET UP TITLE PAGE;;;JSR SESOUN ;* SET SOUND IN TBLJSR SELIVE ;* SET LIVES IN TBL;JSR SETUP;LDA $FF07AND #%11101111  ;* HIRESSTA $FF07;LDA #0STA YBOX;LDA #39STA XSLDA #24STA YSLDX #0LDY #0LDA #32STA CHAR;LDA #$71   ;* COLOUR;JSR BOX    ;* FILL WHOLE SCREEN;JSR PRHISC ;* PRINT HI-SCORES;;JSR PRMENU ;* PRINT MENU;JSR CHSEL  ;* K/J SELECTION;JSR BOXES  ;* LOTS OF BOXES;;LDX #$01STX DELAY+1;;JSR FUNKIT ;* TITLE ON FOR HIGH;JSR HIGH   ;* ANY HIGH-SCORE?;JSR SMOOTH ;* NICE BIT;JSR NICIRQ ;* IRQ'S FOR BOX MOVE;PARTY;JSR FUNKIT ;* PRINT TITLE;LDX #$00JSR DELAY+2;JSR CLBOX;; RUB  OUT  TITLE;JSR BOXES;LDA TEDAND #$0FADC #3STA DELAY+1;JMP PARTY;NORIRQ;SEI;LDA #$0ESTA $314;LDA #$CESTA $315;LDA #$A2STA IRQMSK;CLI;RTS;;.END