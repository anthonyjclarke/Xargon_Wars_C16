; PUT "@:JOYSTIK";;*******************;; READ THE JOYSTICK;;*******************;JPORT = TED+8;;;REDJOS;;LDA DEADBNE NOMOVE;LDA DEMOBEQ NOTDEM;JMP RANMVE      ;* RANDOM MOVE;NOTDEM;LDA JOYSELBNE TRYJOS;JSR KEY;RTS;TRYJOS;LDA #$FD        ;* PORT 0STA JPORT;LDA #$4ASTA XTRCDE      ;* 'LSR A';LDA JPORTEOR #$FFBNE NAYE;; TRY PORT 1;LDA #$FA        ;* PORT 1STA JPORT;LDA #$EASTA XTRCDE      ;* 'NOP';LDA JPORTEOR #$FF;BNE NAYE        ;* READ SOME DATA;;NOMOVE;LDA #0LDX #4;NOM1;STA JLEFT,XDEXBPL NOM1;RTS;;NAYE;ROR AROR JUP;ROR AROR JDOWN;ROR AROR JLEFT;ROR AROR JRIGHT;LSR ALSR ALSR A;XTRCDE;NOP;ROR JFIRE;LDA #1STA JMOVE;RTS;;;;****************;RANMVE;DEC DEMLENBEQ DEMPY;LDA DEMMVEORA #%11000000 ;* ALWAYS FIRE;JMP NAYE;DEMPY;LDA RND+1AND #7ORA #2         ;* 2-7 POSITIONSSTA DEMLEN;LDA TEDAND #1TAX;LDA MVEPAT,XSTA DEMMVE;JMP NAYE;;MVEPAT .BYTE %00001000,%00000100;;.END