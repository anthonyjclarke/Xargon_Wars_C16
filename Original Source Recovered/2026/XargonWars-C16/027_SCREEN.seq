; PUT "@:SCREEN";;*******************************;; SET UP SCREEN DISPLAY FOR PLAY;;*******************************;;;;SETSCR;LDA #39STA XSLDA #24STA YSLDA #$20STA CHARLDA #$71LDX #0LDY #0;JSR BOX;LDA #6STA XSLDA #24STA YSLDA #33STA HITXLDA #0STA HITYJSR PRBOX;LDA #32STA XSLDA #0STA HITXSTA HITYJSR PRBOX;;;LDA #<TEXTSTA PXL+1STA PXL1+1STA PXLL+1;LDA #>TEXTSTA PXL+2STA PXL1+2STA PXLL+2;JSR PRTTXT;JSR PRTGAG;LDX #89   ;*STX $FBB  ;* PRINTINX       ;*STX $FBC  ;* 'TEMP'INX       ;*STX $FBD  ;*;;RTS;;************************;TEXT.BYTE 34,01,'SCORE',00.BYTE 34,02,'00000',00;.BYTE 34,03,'RANK*',00;.BYTE 34,04,'LIVES',00;SCLVES ;* POINTER FOR LIVES;.BYTE 34,05,'  0  ',00.BYTE 34,06,'SHEET',00.BYTE 34,07,' 001 ',00.BYTE 34,22,'LASER',00.BYTE $FF;;;PRTTXT;;LDX #0;;PXL;LDA TEXT,XCMP #$FFBEQ NZTTSTA RUSHXINXPXL1LDA TEXT,XSTA RUSHYINX;SAVE;LDX RUSHXLDY RUSHY;JSR RUSTIC;LOAD;LDY #0;PXLLLDA TEXT,XBEQ NZTAND #$3FSTA (SCLO),YINYINXBNE PXLL;NZT;INXBNE PXL;NZTT;RTS;;;PRTGAG;;PRINT TEMP GAUGE;;LDA #4STA XSLDA #13STA YSLDA #34STA HITXLDA #8STA HITYJSR PRBOX;LDA #$8BSTA SL;LDA #$DSTA SH;LDX #11;FRAK;LDA #87LDY #0STA (SL),Y  ;* COL CHAR;LDA #88LDY #2STA (SL),Y;LDA SHPHA;SECSBC #4;STA SH;LDY #0LDA GACOUL,X;STA (SL),Y;PLA;STA SH;LDA SLCLCADC #40STA SL;LDA SHADC #0STA SH;DEXBPL FRAK;RTS;;**************;GACOUL;.BYTE $45,$45,$45,$45,$45.BYTE $45,$67,$67,$67,$67.BYTE $67,$12;;;;;*************************;; FLASH SCORE & OTHER BITS;;;HEMOGL;DEC RUSHZBEQ GLOBIN;RTS;GLOBIN;LDA #8STA RUSHZ;LDA TED+2AND #%01110111ORA #%00010000STA ATTR;AND #7BEQ GLOBIN;CMP #4BCS GLOBIN;LDX #34;HMGLT;LDA ATTRSTA $828,X;ADC #1STA $828+120,X;ADC #1STA $828+120+80,X;INXCPX #39BNE HMGLT;INC RNKCOLLDA RNKCOLAND #7ASL AASL AASL AASL AORA #$1         ;* WHITESTA RANKNO-$400;;RTS;;;;;.END