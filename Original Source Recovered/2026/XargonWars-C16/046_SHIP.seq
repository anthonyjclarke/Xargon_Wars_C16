; PUT "@:SHIP";;*****************************;;ALL THE SHIP RELATED ROUTINES;;*****************************;;;;PRSHIP;LDA CSHIP ;* NEED TO UPDATE ???BEQ DOIT;;JSR CLSIT;LDA NEWXSTA SHIP ;* NEW POSITION;DOIT;;LDA #80STA TEMP;LDX #0;SH1;LDY SHDAY,X;LDA (SHIP),Y;CMP #101BCC SHIPOK;CMP #108BCS SHIPOK;LDA #1STA DEAD;SHIPOK;LDA TEMPSTA (SHIP),Y;LDA SHIPSTA ILLDA SHIP+1SECSBC #4STA IHLDA SHIPCLSTA (IL),Y ;* COLOUR;INC TEMPINXCPX #7BNE SH1;LDA #0STA CSHIP ;* RESET FLAG;RTS;CLSIT;LDX #6;SH2;LDY SHDAY,XLDA #32STA (SHIP),Y;DEXBPL SH2;RTS;SHDAY;.BYTE $01.BYTE $28,$29,$2A .BYTE $50,$51,$52;;;        *80*;     *81*82*83*;     *84*85*86*;;    SHIP CONSTRUCTION;;;***********;; SHIP MOVE;;***********;;MVSHIP;;;;BIT JLEFTBPL NLEFT;;;******************;; WANTS TO GO LEFT;;******************;;;;LDA SHIPCMP #$49 ;* EXTREME LEFTBEQ NRIGHT;LDA #1STA CSHIP ;* CLEAR SHIPLDX SHIPDEXSTX NEWX ;* SAVE NEW X POS;BNE NRIGHT;NLEFT;BIT JRIGHTBPL NRIGHT;;;*******************;; WANTS TO GO RIGHT;;*******************;LDA SHIPCMP #$65BEQ NRIGHT ;* EXTREME RIGHT;LDA #1STA CSHIP ;* CLS SHIPLDX SHIPINXSTX NEWX ;* NEW X POS;;;NRIGHT;;*******************;; WANT TO FIRE ????;;*******************;BIT JFIREBMI HUMM;RETURN;RTS;HUMM;LDA JFIRECMP OLDFIR;BEQ RETURN;STA OLDFIR;LDA DNTFIRBNE RETURN;LDA FIREBNE SADO  ;* ALREADY FIRING;LDA NFIREBNE SADO ;* TOO HOT TO FIRE;LDA #BSPEED-1STA BULSPD;LDA HEATCLCADC #8STA HEAT;JSR FIRESO ;* LASER FIRE INIT;LDA #0STA BON   ;* NOT READY TO PRINTSTA BOFF  ;* DONT RUB IT;LDA #1STA FIRE  ;* BULLET ON;LDA SHIPSECSBC #$47STA BULX  ;* XPOS;LDA #20STA BULY  ;* YPOS;LDX BULXLDY BULY;JSR XY;LDA SLSTA BULLETLDA SHSTA BULLET+1;LDA #1STA BON;; TELL IRQ TO PRINT IT;SADO;RTS;;MVEBUL;LDA FIREBNE PLEB;RTS;PLEB;INC BULSPDLDA BULSPD;CMP #BSPEED;BEQ MVEYAH;RTS;;MVEYAH;LDA #0STA BULSPD;LDY BULYDEYSTY NEWBYBEQ RSETBU ;* REACHED TOP;LDA #1STA BOFF ;* CLS & SET NEW Y POSSTA BON  ;* PRINT NEW BULLET;RTS;RSETBU;; RESET BULLET;LDY #0STY FIRE;STA BOFFSTA BON;LDA #32       ;* RUB OUT BULLETSTA (BULLET),Y;RTS;;;PRBLET;LDA BOFFBEQ NORUB;HOHO;; USED TO RUB OUT BULLET HERE;LDX BULXLDY NEWBYSTY BULYJSR XY;LDA SLSTA BULLETLDA SHSTA BULLET+1 ;* NEW POS;;NORUB;LDA BONBEQ SILLY;;             ;*******************LDA CLAL      ;* MAKE SURE ALIEN *BNE UPHRS     ;* NOT BEING CLS   *;             ;*******************;;             ;*******************LDA PRAL      ;* WAIT FOR ALIENS *BNE UPYRS     ;* TO BE ON SCREEN *;             ;*******************;UPHRS;RTS;UPYRS;LDY #40LDA (BULLET),Y;PHA;LDA BOFFBEQ NRUNT;LDA #0STA BOFF;LDA #32STA (BULLET),Y;NRUNT;PLA;JSR CHKBULBCS ELEPH;LDY #0LDA (BULLET),Y;JSR CHKBULBCC NOFAG      ;* OK;ELEPH;STA UNDER      ;* SAVE CHAR UNDER;LDA #1STA HITFLG;LDA BULX       ;* PASS X POSSTA HITXLDA BULY       ;* AND Y POS.STA HITY;JSR ALIHIT     ;* ?!?!?!?;RTS            ;* DON'T PRINT BUL.;NOFAG;LDA #92STA (BULLET),Y   ;* CHAR;LDA BULLET+1PHASECSBC #4STA BULLET+1;LDA #BCOLORSTA (BULLET),Y   ;* COLOUR;PLASTA BULLET+1;SILLY;RTS;;;CHKBUL      ;* CHEK UNDR BULLET;CMP #101BCC CHKOK   ;* NO;CMP #104BCS CHKOK   ;* NO;; YES;SEC;RTS;CHKOK;CLC;RTS;.END SHIP;RTS