; PUT "@:PLAY-GAME";;;**************************;;       PLAY STUFF;;**************************;PLGAME;JSR NORIRQ ;* NORMAL IRQ'S;LDX #0;FETCH1;LDA SAVECH,XSTA CHARS,X;INXCPX #$A0BNE FETCH1;; CHARS BACK AFTER SCROLL;;           *******************LDX #95    ;* LENGTH OF TABLE *LDA #$FF   ;*******************;TRS;STA ONTBL,X;DEXBPL TRS ;* NICE COMPUTER EH !!;; FILL STAR TABLE;;JSR CLPAG3  ;* CLEAR PAGE 3 & 0;LDA #$71STA SHIPCL;LDA #<SHIPSTSTA SHIPLDA #>SHIPSTSTA SHIP+1;LDA CLIV+11STA SCLVES+4 ;* ASCII LIVES;LDX LIVESSTX GLIVES   ;* GAME LIVES;LDX #$30STX CLRMES+7 ;* LSB CLEARED MESSINXSTX CLRMES+8 ;* MSB CLEARED MESS;LDA #1STA DECSHT   ;* DECIMAL SHEET CNTSTA RUSHZ    ;* COUNTER;;LDA DEMOBEQ NODMST;LDA TED+4AND #7       ;* RANDOM SHEET 0-7;NODMST;STA SHEETN;JSR SETUP    ;* TED INIT.JSR INSTAR   ;* STAR POSITIONSJSR SETSCR   ;* PRINT SCREENJSR INITSR   ;* INIT SHEET NO ^;;*******************************;LDX #3LDA #0;STOPST;STA STOP,XDEX;BPL STOPST   ;* STOP ALL STARS;;*******************************;LDA #1STA DNTFIR ;* NO FIRING;JSR SETIRQ;JSR NICSTR ;* START STARS;LDA #1STA PLAYIN ;* GAME IN PROGRESS;START;JSR RANKER;LDX #$14LDY #$00;PUP;DEYBNE PUP;DEXBNE PUP;;INC MOVECTLDA MOVECTCMP MVESPDBNE FREDDY;LDA #0STA MOVECT;JSR MVEALL ;* UPDATE ALIENSJSR UPEXPL ;* UPDATE EXPLOSIONS;FREDDY;INC BERMB ;* IT'S A BERMB !LDA BERMBCMP FRESPD;BNE CLUSEA;LDA #0STA BERMB;LDA DEADBNE CLUSEA ;* HE'S DEAD SO NO MORE;          ;* BOMBS;JSR NEWBMB;CLUSEA;INC CLOTLDA CLOTCMP BOMSPDBNE DNTMV;LDA #0STA CLOT;JSR MVEBMB ;* MOVE BOMBS DOWN;DNTMV;LDA FINITO ;* GAME OVERBEQ NOYEP  ;* NOT YET;JMP KATH   ;* FINISHED;NOYEP;LDA CLRSHT ;* FINISHED SHEETBEQ INSPEC;JSR SHTOVR ;* SET UP FOR NEXT ONE;INSPEC;JMP START;;;;.END