; PUT "@:SOUND";;********************************;;HOPEFULLY THIS SOUND WILL BE AN;IMPROVEMENT OVER D***'S WHOOPEE;SOUND ROUTINES & WILL WORK !!!!;;********************************;ALEXPF=14 ;* ALIEN EXPLOSION FREQ;;;;SOUND;; CALLED UNDER INTERRUPT;LDA CFLAGBNE SDIU;RTS;SDIU;LDA NFIRE   ;* 1=NO SHOOTINGBEQ ONJ;JSR UPHTSO  ;* LASER OV/HEATED;JMP ONL;ONJ;JSR UPLZSO  ;* LASER FIRING;ONL;LDA DEADBNE SHIDED;JSR UPSHIT  ;* ALIEN HIT SOUND;SHIDED;RTS;;********************************;VOL    = $FF11SOU1LO = $FF0ESOU1HI = $FF12SOU2LO = $FF0FSOU2HI = $FF10;;;;********************;; LASER FIRING SOUND;;********************;;FIRESO      ;* START SOUND;LDA CFLAG   ;* SOUND ON/OFFBNE SOUON;RTS;SOUON;LDA #3STA SOHIORA SOU1HISTA SOU1HI;LDA #1STA SOU1LO;LDA #40STA SO1LEN;LDA #1STA WHSND   ;* LASER SND ON;LDA #%00010111ORA VOLSTA VOL ;* CHAN#1 & VOL 7;RTS;;****************;UPLZSO;LDA WHSNDBEQ LUTER;DEC SO1LEN  ;* LENGTHBNE NTFIN1  ;* NOT ENDED;LDA #0STA WHSND;LUTER;LDA #%11101111AND VOLSTA VOL     ;* CHAN 1 OFF;RTS;;NTFIN1;;LDA SOU1LOSECSBC #$04STA SOU1LO;BCS NOTHI;DEC SOHILDA SOHIAND #3STA SOHIORA SOU1HISTA SOU1HI;NOTHI;RTS;;*******************************;HEATSO;; INIT OVER HEAT SOUND;LDA CFLAGBNE FOREST;RTS;FOREST;LDA #3ORA SOU1HISTA SOU1HI;LDA #1STA SOU1LOSTA SOLZ     ;* SOUND ON;LDA #%00010111ORA VOLSTA VOL ;* ON;LDA #0STA WHSND    ; NO LASER SND;RTS;;;UPHTSO;;;;;LDA SOSTATPHA;PLP;ROL SOU1LO;PHPPLA;STA SOSTAT ;* STATUS REG;IFT;RTS;;;;****************************;;SETEXP;; START EXPLOSION SOUND;LDA CFLAGBNE ESTR;RTS;ESTR;LDA #$FFSTA SOU2LOSTA SOU2HI;LDA #%01001101 ;*VOL & CH#2 NOISESTA VOL;LDA #1STA SO2LEN;RTS;;;DYEVOL;; VOLUME DECAY;DEC SO2LENBEQ SHAUN;RTS;SHAUN;LDA #5STA SO2LEN;LDA VOL;PHA;AND #$F0STA TT2;PLA;AND #15SECSBC #1AND #15;ORA TT2STA VOL;RTS;;***********************;;;  ALIEN HIT SOUND;HITSND;LDA CFLAGBNE HITSOK;RTS;HITSOK;LDA DEADBEQ FLUCK;RTS;FLUCK;; SOUND ON & HE'S NOT DEAD !;LDA #$03STA SOU2HILDA #$FFSTA SOU2LO;LDA VOLORA #%01001111 ;* NOISE 2STA VOL;LDA #1STA SHITSO;RTS;;UPSHIT;LDA SHITSOBNE SOON;RTS;SOON;LDA SOU2LOSECSBC #ALEXPFSTA SOU2LO;BCC FLOWER ;* POWER ITS OVER;RTS;FLOWER;LDA VOLAND #%10011111STA VOL;; TURN OFF ANYTHING ON CH#2;LDA #0STA SHITSO;;RTS;;;.END