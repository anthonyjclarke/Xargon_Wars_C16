; PUT "@:SHTABLE";;;;;SHTABL;; EACH SHEET TABLE TAKES UP 16; BYTES;;;;*********************************;;          SHEET 1;;*********************************;.BYTE PAT1LE ;* MOVEMENT LENGTH.WORD MOV1DA ;* MOVEMENT DATA.BYTE 8      ;* ANIMATION SPEED.BYTE 8      ;* FIRING SPEED.BYTE $67    ;* MULTI COLOUR1.BYTE $12    ;* MULTI COLOUR2.BYTE $7E    ;* MULTI COLOUR3.BYTE 4      ;* MOVEMENT SPEED.WORD CHARD1 ;* CHARACTER DATA.WORD ALXY1  ;* INITIAL POSITIONS.BYTE NUMA1  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;;*********************************;;          SHEET 2;;*********************************;.BYTE PAT2LE ;* MOVEMENT LENGTH.WORD MOV2DA ;* MOVEMENT DATA.BYTE 14     ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $41    ;* MULTI COLOUR1.BYTE $75    ;* MULTI COLOUR2.BYTE $59    ;* MULTI COLOUR3.BYTE 4      ;* MOVEMENT SPEED.WORD CHARD2 ;* CHARACTER DATA.WORD ALXY2  ;* INITIAL POSITIONS.BYTE NUMA2  ;* NUMBER OF ALIENS.BYTE 2      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 3;;*********************************;.BYTE PAT3LE ;* MOVEMENT LENGTH.WORD MOV3DA ;* MOVEMENT DATA.BYTE 4      ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $79    ;* MULTI COLOUR1.BYTE $7A    ;* MULTI COLOUR2.BYTE $4E    ;* MULTI COLOUR3.BYTE 4      ;* MOVEMENT SPEED.WORD CHARD3 ;* CHARACTER DATA.WORD ALXY3  ;* INITIAL POSITIONS.BYTE NUMA3  ;* NUMBER OF ALIENS.BYTE 3      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 4;;*********************************;.BYTE PAT4LE ;* MOVEMENT LENGTH.WORD MOV4DA ;* MOVEMENT DATA.BYTE 4      ;* ANIMATION SPEED.BYTE 8      ;* FIRING SPEED.BYTE $71    ;* MULTI COLOUR1.BYTE $72    ;* MULTI COLOUR2.BYTE $42    ;* MULTI COLOUR3.BYTE 4      ;* MOVEMENT SPEED.WORD CHARD4 ;* CHARACTER DATA.WORD ALXY4  ;* INITIAL POSITIONS.BYTE NUMA4  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 5;;*********************************;.BYTE PAT5LE ;* MOVEMENT LENGTH.WORD MOV5DA ;* MOVEMENT DATA.BYTE 10     ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $12    ;* MULTI COLOUR1.BYTE $67    ;* MULTI COLOUR2.BYTE $3E    ;* MULTI COLOUR3.BYTE 4      ;* MOVEMENT SPEED.WORD CHARD5 ;* CHARACTER DATA.WORD ALXY5  ;* INITIAL POSITIONS.BYTE NUMA5  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 6;;*********************************;.BYTE PAT6LE ;* MOVEMENT LENGTH.WORD MOV6DA ;* MOVEMENT DATA.BYTE 10     ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $74    ;* MULTI COLOUR1.BYTE $47    ;* MULTI COLOUR2.BYTE $4A    ;* MULTI COLOUR3.BYTE 4      ;* MOVEMENT SPEED.WORD CHARD6 ;* CHARACTER DATA.WORD ALXY6  ;* INITIAL POSITIONS.BYTE NUMA6  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;* BOMB SPEED;;*********************************;;          SHEET 7;;*********************************;.BYTE PAT7LE ;* MOVEMENT LENGTH.WORD MOV7DA ;* MOVEMENT DATA.BYTE 4      ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $41    ;* MULTI COLOUR1.BYTE $22    ;* MULTI COLOUR2.BYTE $2D    ;* MULTI COLOUR3.BYTE 8      ;* MOVEMENT SPEED.WORD CHARD7 ;* CHARACTER DATA.WORD ALXY7  ;* INITIAL POSITIONS.BYTE NUMA7  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 8;;*********************************;.BYTE PAT8LE ;* MOVEMENT LENGTH.WORD MOV8DA ;* MOVEMENT DATA.BYTE 10     ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $71    ;* MULTI COLOUR1.BYTE $72    ;* MULTI COLOUR2.BYTE $24    ;* MULTI COLOUR3.BYTE 8      ;* MOVEMENT SPEED.WORD CHARD8 ;* CHARACTER DATA.WORD ALXY8  ;* INITIAL POSITIONS.BYTE NUMA8  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 9;;*********************************;.BYTE PAT9LE ;* MOVEMENT LENGTH.WORD MOV9DA ;* MOVEMENT DATA.BYTE 8      ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $4B    ;* MULTI COLOUR1.BYTE $71    ;* MULTI COLOUR2.BYTE $4C    ;* MULTI COLOUR3.BYTE 8      ;* MOVEMENT SPEED.WORD CHARD9 ;* CHARACTER DATA.WORD ALXY9  ;* INITIAL POSITIONS.BYTE NUMA9  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 10;;*********************************;.BYTE PATALE ;* MOVEMENT LENGTH.WORD MOVADA ;* MOVEMENT DATA.BYTE 8      ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $4B    ;* MULTI COLOUR1.BYTE $71    ;* MULTI COLOUR2.BYTE $4C    ;* MULTI COLOUR3.BYTE 8      ;* MOVEMENT SPEED.WORD CHARDA ;* CHARACTER DATA.WORD ALXYA  ;* INITIAL POSITIONS.BYTE NUMAA  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 11;;*********************************;.BYTE PATBLE ;* MOVEMENT LENGTH.WORD MOVBDA ;* MOVEMENT DATA.BYTE 15     ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $11    ;* MULTI COLOUR1.BYTE $41    ;* MULTI COLOUR2.BYTE $79    ;* MULTI COLOUR3.BYTE 6      ;* MOVEMENT SPEED.WORD CHARDB ;* CHARACTER DATA.WORD ALXYB  ;* INITIAL POSITIONS.BYTE NUMAB  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 12;;*********************************;.BYTE PATCLE ;* MOVEMENT LENGTH.WORD MOVCDA ;* MOVEMENT DATA.BYTE 8      ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $55    ;* MULTI COLOUR1.BYTE $51    ;* MULTI COLOUR2.BYTE $5C    ;* MULTI COLOUR3.BYTE 6      ;* MOVEMENT SPEED.WORD CHARDC ;* CHARACTER DATA.WORD ALXYC  ;* INITIAL POSITIONS.BYTE NUMAC  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 13;;*********************************;.BYTE PATDLE ;* MOVEMENT LENGTH.WORD MOVDDA ;* MOVEMENT DATA.BYTE 12     ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $71    ;* MULTI COLOUR1.BYTE $72    ;* MULTI COLOUR2.BYTE $77    ;* MULTI COLOUR3.BYTE 3      ;* MOVEMENT SPEED.WORD CHARDD ;* CHARACTER DATA.WORD ALXYD  ;* INITIAL POSITIONS.BYTE NUMAD  ;* NUMBER OF ALIENS.BYTE 2      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 14;;*********************************;.BYTE PATELE ;* MOVEMENT LENGTH.WORD MOVEDA ;* MOVEMENT DATA.BYTE 4      ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $12    ;* MULTI COLOUR1.BYTE $67    ;* MULTI COLOUR2.BYTE $3E    ;* MULTI COLOUR3.BYTE 8      ;* MOVEMENT SPEED.WORD CHARDE ;* CHARACTER DATA.WORD ALXYE  ;* INITIAL POSITIONS.BYTE NUMAE  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 15;;*********************************;.BYTE PATFLE ;* MOVEMENT LENGTH.WORD MOVFDA ;* MOVEMENT DATA.BYTE 16     ;* ANIMATION SPEED.BYTE 4      ;* FIRING SPEED.BYTE $71    ;* MULTI COLOUR1.BYTE $72    ;* MULTI COLOUR2.BYTE $56    ;* MULTI COLOUR3.BYTE 3      ;* MOVEMENT SPEED.WORD CHARDF ;* CHARACTER DATA.WORD ALXYF  ;* INITIAL POSITIONS.BYTE NUMAF  ;* NUMBER OF ALIENS.BYTE 4      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;          SHEET 16;;*********************************;.BYTE PATGLE ;* MOVEMENT LENGTH.WORD MOVGDA ;* MOVEMENT DATA.BYTE 10     ;* ANIMATION SPEED.BYTE 2      ;* FIRING SPEED.BYTE $12    ;* MULTI COLOUR1.BYTE $67    ;* MULTI COLOUR2.BYTE $3E    ;* MULTI COLOUR3.BYTE 3      ;* MOVEMENT SPEED.WORD CHARDG ;* CHARACTER DATA.WORD ALXYG  ;* INITIAL POSITIONS.BYTE NUMAG  ;* NUMBER OF ALIENS.BYTE 2      ;* BOMB SPEED.BYTE 0      ;*;;*********************************;;.BYTE $FF,$FF,$FF,$FF.BYTE $FF,$FF,$FF,$FF.BYTE $FF,$FF,$FF,$FF.BYTE $FF,$FF,$FF,$FF;;;.END