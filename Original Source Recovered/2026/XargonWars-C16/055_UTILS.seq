; CPUT "@:UTILS";;**************************;;        UTILITIES;;**************************;;;;XY;;;;COVERTS X,Y (REGS) TO SCREEN;;RESULTS IN SL,SH POINT TO SCREEN;           CL,CH POINT TO COLOUR;;;;TYAASL ATAYLDA SCRPTR,YSTA SLLDA SCRPTR+1,YSTA SH;TXACLCADC SLSTA SLSTA CL;LDA SHADC #0STA SH;SECSBC #$4 ;* CALC COLOUR ADDR.STA CH;;;RTS;;;RANDOM;;; RANDOM NUMBER AT RND - RND+3;;;CLCLDY #$29LDX #$FC;LOOP;TYALDY RND+4,XADC RND+4,XSTA RND+4,XINXBNE LOOP;;RTS;;;*************;SYNC;LDA TED+28AND #1BNE SYNC;SYNC1;LDA TED+28AND #1BEQ SYNC1;RTS;;*************;CLPAG3;LDX #$3CLDA #0;CLZ3;STA $0300,XINXBNE CLZ3;; NOW CLEAR PAGE 0;LDX #$40;CLPZ1;STA $02,XDEXBPL CLPZ1;RTS;.END