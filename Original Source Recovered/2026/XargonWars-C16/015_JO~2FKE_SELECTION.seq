; PUT "@:JO/KE SELECTION";;;;;;PRSEL;LDX #0;LDA #$F5STA SL;LDA #$0DSTA SH;SUTRAM;LDA #32;LDY JOYSELBNE RAT1;LDA KST,X;RAT1;LDY #0AND #$3FSTA (SL),Y;LDA #32;LDY JOYSELBEQ RAT2;LDA JST,X;RAT2;LDY #17AND #$3FSTA (SL),Y;LDA SLCLCADC #40STA SL;LDA SHADC #0STA SH;INXCPX #8;BNE SUTRAM;RTS;;;;CHSEL;;LDA #$04LDX #$EF;JSR KEYIT;BCC NOJ;; SELECTED JOYSTICK;LDA #1STA JOYSEL;;NOJ;LDA #$20LDX #$EF;JSR KEYIT;BCC NOK;; SELECTED KEYBOARD;LDA #0STA JOYSEL;;NOK;JSR PRSEL;RTS;;***********;KST .BYTE 'KEYBOARD'JST .BYTE 'JOYSTICK';;;;;.END