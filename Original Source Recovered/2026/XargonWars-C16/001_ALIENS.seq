; >S:ALIENS; PUT "ALIENS";;;********************************;; ALL THE ALIEN RELATED ROUTINES;;********************************;;; ALLOWING FOR A MAX. OF 40; ALIENS THE TABLES BELOW ARE SET;;; ALIEN CLS OUT TABLE;;; ALIEN PRINT OUT TABLE;;;  BOTH TABLES AT 'EXTRA-MEMORY';PRALIN;; PRINT THE ALIENS - THE ALIOUT; TABLE MUST HAVE ALREADY BEEN; SET UP.;;LDA PRAL ;* PRINT ALIENS FLAG ?BEQ NOWAY;; CHARS ARE SET UP AL 'ALILOP';LDX #<ALIPRTSTX SLFMD1+1INXSTX SLFMD2+1;LDA #>ALIPRTSTA SLFMD1+2STA SLFMD2+2;JSR ALILOP;; THE PRINT FLAG IS NOT RESET HERE; BECEAUSE THE ALIENS MUST STILL; BE PRINTED OTHERWISE THEY GET; RUBBED OUT BY THE STARS  !!!!;NOWAY;RTS;;CLALIN;; CLEAR THE ALIENS - THE ALIOUT; TABLE MUST HAVE ALREADY BEEN; SET UP.;LDA CLAL ;* CLEAR ALIENS FLAG ?BEQ NOCLS;LDX #32STX C1STX C2STX C3  ;* CHARS;LDX #<ALICLSSTX SLFMD1+1INXSTX SLFMD2+1;LDA #>ALICLSSTA SLFMD1+2STA SLFMD2+2;JSR ALILOP;LDA #0STA CLAL ;* RESET CLEAR FLAG;NOCLS;RTS;;;;ALILOP;LDA #0STA TEMP;PRZX;LDA TEMPASL ATAX;SLFMD1 LDA $FFFF,XSTA ILSLFMD2 LDA $FFFF,XSTA IH;CMP #$FFBEQ ROCK ;* YEAH !;LDA CLALBNE GIDO;; DON'T DO THIS IF CLAL IS SET; BECEAUSE IT MEANS THAT THIS; ROUTINE IS BEING CALLED BY CLS;LDA IHBPL BACK ;* PUT BACK TO ALIEN CHR.;AND #$7FSTA IH;LDX #105STX C1INXSTX C2INXSTX C3BNE GIDO;; CHANGED CHAR TO EXPLOSION;       NICE EH !!!!!;BACK;LDX #101STX C1INXSTX C2INXSTX C3;; SET CHARS BACK TO ALIEN;GIDO;; SCREEN ADDRESS SET;LDA IHAND #$F    ;* 0 - 15STA IH;LDY #2;ONLP;LDA C1,YSTA (IL),Y  ;* CHARS ONDEY;BPL ONLP;;LDA CLAL ;* ARE WE CLEARING ?BNE PEEL ;* YES;; THERE'S NO NEED TO DO THE COLS.;LDA IHSECSBC #4STA IH;LDA ATTCOL  ;* COLOUR;; Y HOLD NUM OF CHARS TO PUT ON;LDY #2;COLP;STA (IL),YDEYBPL COLP;PEEL;INC TEMP;BNE PRZX;ROCK;RTS;;EXCHR .BYTE 105,108,111;;MVEALL;;****************************;; DO ALL THE MOVING OF THE; ALIENS ABD LEAVE THE TABLES; 'ALICLS' & 'ALIPRT' SET UP; WITH THE ALIENS THAT NEED; PRINTING & CLEARING.;;****************************;LDA #0STA NOBBOSTA CLAL ;* CLEAR ALIEN FLAGSTA PRAL ;* PRINT ALIEN FLAGSTA SIMON;LDX #0;BUMP;LDA ALIPRT,XSTA ALICLS,X;LDA ALIPRT+1,XAND #$0FSTA ALICLS+1,X;INXCPX #62BNE BUMP;;; COPY THE LAST PRINTED ALIENS; FROM THE ALIPRT TABLE TO THE; ALICLS TABLE AS THEY NOW NEED; TO BE CLEARED FROM THE SCREEN;;;CALL;LDA NOBBOASL ACLCADC NOBBOTAX;;LDA ALIENS,X   ;* X POSCMP #$FFBNE DONALD;JMP MISSED  ;* ITS DEAD;DONALD;AND #%00011111 ;* MIGHT BE EXPLOS.STA ALXPS;LDA ALIENS+1,X ;* Y POSAND #$7F       ;* IGNORE EXPLOSIONSTA ALYPS;TXAPHA ;* SAVE POINTER INTO ALIENS;;LDY ALIENS+2,X;; OFFSET INTO MOVEMENT DATA;INY ;* NEXT ONE;CPY MVELEN ;* END OF MOVEMENT ?BNE NTEND;LDY #0  ;* RESET TO START;NTEND;TYA;STA ALIENS+2,X ;* SAVE POINTER;LDA (MVEDAL),Y ;* NEXT MOVE DIR.;TAY;LDA ALXPSCLCADC XTBL,YTAX;LDA ALYPSCLCADC YTBL,YTAY;;*************************;CPX #0  ;* OFF LEFT ?BNE OK1;LDX #29 ;* START AT RIGHT;OK1;CPX #30 ;* OFF RIGHT ?BCC OUTX;LDX #1  ;* MOVE TO LEFT;OUTX;;****************************;CPY #0     ;* OFF TOP ?BNE OK2;LDY #23    ;* MOVE TO BOTTOM;OK2;CPY #24    ;* OFF BOTTOM ?BCC OUTY;LDY #1     ;* MOVE TO TOP;OUTY;;****************************;STX ALXPSSTY ALYPS;;PLA ;* POINTER INTO ALIENS TABLEPHATAX;;LDA ALIENS,XAND #%11100000 ;* EX. COUNTORA ALXPS      ;* NEW X POSSTA ALIENS,X;LDA ALIENS+1,X ;* NEW Y POSAND #$80ORA ALYPS      ;* COPY TOP BITSTA ALIENS+1,X ;* THERE THAT'S IT;;LDX ALXPSLDY ALYPS;JSR RUSTIC  ;* CON. TO SCREEN ADD.;LDA SIMONASL ATAX         ;* X=ALTEM*2PLATAY         ;* Y=ALTEM*3;LDA SCLOSTA ALIPRT,X   ;*ALIENS INTO PRINT;       LDA ALIENS+1,Y ;* HI-BITAND #$80ORA SCHI;; COPY THE TOP BIT OF ALIENS; Y POS WHICH WOULD BE SET IF IT; HAS BEEN DEADED .;INC SIMON;STA ALIPRT+1,X ;*TABLE.;;MISSED ;* ?????;INC NOBBOLDA NOBBOCMP NUMALI;BEQ HAYA;JMP CALL;HAYA;;;LDA SIMONASL ATAY;LDA #$FFSTA ALIPRT,YSTA ALIPRT+1,Y;LDX #1STX PRALSTX CLAL;;RTS;;;********************************;; Y MOVEMENT TABLE;YTBL;.BYTE $FF,$FF,0,1,1,1,0,$FF,0;;;********************************;; X MOVEMENT TABLE;XTBL;.BYTE 0,1,1,1,0,$FF,$FF,$FF,0;;;********************************;; ANOTHER X,Y CONVERTER AS IT IS; UNKNOWN AS TO WHETHER THE 'XY'; ROUTINE WILL BE BEING USED IN; THE IRQ OR TIMER ROUTINES !!!!;;********************************;RUSTIC;TYAASL ATAYLDA SCRPTR,YSTA SCLOLDA SCRPTR+1,YSTA SCHI;TXA;CLCADC SCLOSTA SCLO;LDA SCHIADC #0STA SCHI;RTS;;;.END ALIENS