; PUT "@:SAVER";;; THIS WILL SAVE THE AUTO-RUN; LOADER;;*******************;LOAD   = $FFD5SAVE   = $FFD8SETLFS = $FFBASCNKEY = $FF9FSETMSG = $FF90SETNAM = $FFBDTEMP   = $04;MESVEC = $0324START  = MESVECEND    = $0326  ;* START + 2;;LENGTH = $50;;;*=$3000;LDA #$00JSR SETMSG;JSR WAIT;LDA MESVECSTA TEMPLDA #$50STA MESVEC;LDA MESVEC+1STA TEMP+1LDA #$03STA MESVEC+1;LDA #1         ;* CASSETTELDY #3         ;* ONLY DO 'LOAD'JSR SETLFS;LDA #LENGTH    ;* FILENAME +LDX #<FILENM   ;* LOADER WHICHLDY #>FILENM   ;* SITS AT $0350JSR SETNAM;LDA #<STARTSTA $02;LDA #>STARTSTA $03;LDA #$02;LDX #<ENDLDY #>END;JSR SAVE;LDA TEMPSTA MESVEC;LDA TEMP+1STA MESVEC+1;BRK;;***************;WAIT;LDX #$20LDY #0;LP1;DEYBNE LP1;DEXBNE LP1;;LDX #0;WA1;LDA PRE,X;JSR $FFD2;BEQ WAK;INXBNE WA1;WAK;JSR SCNKEY;BEQ WAK;RTS;;****************;PRE;.BYTE 13,10,'PRESS A KEY',13,10,13,10,0;;;****************;; PC = $0337;FILENM .BYTE 'XARGON-WARS';.BYTE 0,0,0,0,0.BYTE 0,0,0,0,0.BYTE 0,0,0,0;;;; THIS WILL BE AT $0350;PROG;; THIS IS THE LOADER;;;INC $FF19BNE PROGBEQ PROG;LDA #1    ;* CASSETTELDX #$FFLDY #$FF;JSR SETLFS;LDA #0JSR SETNAM  ;* NO NAME;LDA #0      ;* LOADLDX #$FFLDY #$FF;JSR LOAD;INC $FF19;LDA #0LDX #$FFLDY #$FF;JSR LOAD;;NOPNOPNOPNOPNOPNOP;;FRAK;;;.END