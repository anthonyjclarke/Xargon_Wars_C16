# Preserve historical input bytes, including CR-only disk text and CRLF 1992 exports.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
Makefile text eol=lf
*.png binary
*.gif binary
*.jpg binary
*.JPG binary
*.prg binary
*.d64 binary
*.ZIP binary
*.seq binary

# These override generic rules for every preserved input.
"/Recovered Source/**" -text -whitespace -diff
"/Original Artifacts/**" -text -whitespace -diff
